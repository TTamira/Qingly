{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "qingxu",
  "version": "0.2.0",
  "identifier": "com.qingxu.workbench",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node scripts/sync-web.js",
    "beforeBuildCommand": "node scripts/sync-web.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "青序",
        "width": 1820,
        "height": 1195,
        "minWidth": 1820,
        "minHeight": 1195,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
